---
import { url } from '@/utils/url';

interface Props {
  variant?: 'inline' | 'fullpage';
  title?: string;
  description?: string;
}

const {
  variant = 'inline',
  title = 'Briefe aus zwei Welten',
  description = 'Baufortschritte aus Saboo, Reiseberichte von Lama Samten, Medical-Camp-Updates — ca. viermal im Jahr. Kein Spam.',
} = Astro.props;

const brevoFormUrl = import.meta.env.PUBLIC_BREVO_FORM_URL || '';
const isPlaceholder = !brevoFormUrl || brevoFormUrl.includes('PLACEHOLDER');
---

{variant === 'inline' ? (
  <section class="section-padding-sm bg-brand-creme-dark">
    <div class="container-content">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-serif text-h2 text-brand-text mb-3">{title}</h2>
        <p class="text-body text-brand-text/70 mb-8">{description}</p>

        {isPlaceholder ? (
          <div class="p-6 rounded-card bg-white shadow-card">
            <p class="text-small text-amber-700 mb-4">
              ⚙️ Brevo-Formular-URL noch nicht konfiguriert. Bitte <code class="bg-amber-50 px-1 rounded">PUBLIC_BREVO_FORM_URL</code> in .env setzen.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <input type="email" placeholder="Ihre E-Mail-Adresse" disabled
                class="flex-1 px-4 py-3 rounded-full border border-brand-creme-dark bg-brand-creme text-brand-text/50 cursor-not-allowed" />
              <button disabled class="btn-primary opacity-50 cursor-not-allowed">Anmelden</button>
            </div>
          </div>
        ) : (
          <form action={brevoFormUrl} method="POST" class="space-y-4">
            <input type="hidden" name="locale" value="de" />
            <input type="hidden" name="html_type" value="simple" />

            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="text"
                name="FNAME"
                placeholder="Vorname (optional)"
                autocomplete="given-name"
                class="flex-shrink-0 w-full sm:w-40 px-4 py-3 rounded-full border border-brand-creme-dark bg-white text-brand-text placeholder-brand-text/40 focus:outline-none focus:ring-2 focus:ring-brand-ocker/50 focus:border-brand-ocker transition-colors"
              />
              <input
                type="email"
                name="EMAIL"
                placeholder="Ihre E-Mail-Adresse *"
                required
                autocomplete="email"
                class="flex-1 px-4 py-3 rounded-full border border-brand-creme-dark bg-white text-brand-text placeholder-brand-text/40 focus:outline-none focus:ring-2 focus:ring-brand-ocker/50 focus:border-brand-ocker transition-colors"
              />
              <button type="submit" class="btn-primary flex-shrink-0">Anmelden</button>
            </div>

            <div class="flex items-start gap-3 text-left max-w-lg mx-auto">
              <input
                type="checkbox"
                id="newsletter-consent"
                name="OPT_IN"
                value="1"
                required
                class="mt-0.5 flex-shrink-0 w-4 h-4 rounded border-brand-creme-dark text-brand-ocker focus:ring-brand-ocker"
              />
              <label for="newsletter-consent" class="text-caption text-brand-text/60">
                Ich möchte den Newsletter von Himalaya-Haus e.V. erhalten und akzeptiere die
                <a href={url('/datenschutz/')} class="text-brand-ocker hover:underline">Datenschutzerklärung</a>.
                Abmeldung jederzeit per Link im Newsletter.
              </label>
            </div>
          </form>
        )}

        <p class="text-caption text-brand-text/40 mt-4">
          Doppelter Opt-in · DSGVO-konform via Brevo · Jederzeit abmeldbar
        </p>
      </div>
    </div>
  </section>
) : (
  <!-- fullpage variant -->
  <div class="max-w-xl mx-auto">
    <h1 class="font-serif text-h1 text-brand-text mb-4">{title}</h1>
    <p class="text-body-lg text-brand-text/70 mb-8">{description}</p>

    {isPlaceholder ? (
      <div class="p-6 rounded-card bg-brand-creme-dark border border-amber-200">
        <p class="text-small text-amber-700">
          ⚙️ Brevo-Formular-URL noch nicht konfiguriert.
        </p>
      </div>
    ) : (
      <form action={brevoFormUrl} method="POST" class="space-y-5">
        <input type="hidden" name="locale" value="de" />
        <input type="hidden" name="html_type" value="simple" />

        <div>
          <label for="nl-fname" class="block text-small font-semibold text-brand-text mb-1.5">Vorname (optional)</label>
          <input type="text" id="nl-fname" name="FNAME" autocomplete="given-name"
            class="w-full px-4 py-3 rounded-lg border border-brand-creme-dark bg-white text-brand-text placeholder-brand-text/40 focus:outline-none focus:ring-2 focus:ring-brand-ocker/50 focus:border-brand-ocker" />
        </div>
        <div>
          <label for="nl-email" class="block text-small font-semibold text-brand-text mb-1.5">E-Mail-Adresse *</label>
          <input type="email" id="nl-email" name="EMAIL" required autocomplete="email"
            class="w-full px-4 py-3 rounded-lg border border-brand-creme-dark bg-white text-brand-text placeholder-brand-text/40 focus:outline-none focus:ring-2 focus:ring-brand-ocker/50 focus:border-brand-ocker" />
        </div>
        <div class="flex items-start gap-3">
          <input type="checkbox" id="nl-consent" name="OPT_IN" value="1" required
            class="mt-0.5 flex-shrink-0 w-4 h-4 rounded border-brand-creme-dark text-brand-ocker focus:ring-brand-ocker" />
          <label for="nl-consent" class="text-small text-brand-text/70">
            Ich möchte den Newsletter von Himalaya-Haus e.V. erhalten und akzeptiere die
            <a href={url('/datenschutz/')} class="text-brand-ocker hover:underline">Datenschutzerklärung</a>.
            Abmeldung jederzeit möglich.
          </label>
        </div>
        <button type="submit" class="btn-primary w-full justify-center">Newsletter abonnieren</button>
      </form>
    )}
  </div>
)}
