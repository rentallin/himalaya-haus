---
interface Props {
  title: string;
  description: string;
  href: string;
  status: 'im-bau' | 'aktiv' | 'abgeschlossen' | 'planung';
  image?: string;
  imageAlt?: string;
  label?: string;
  variant?: 'vertikal' | 'horizontal' | 'featured';
}

const {
  title,
  description,
  href,
  status,
  image,
  imageAlt,
  label,
  variant = 'vertikal',
} = Astro.props;

const statusConfig = {
  'im-bau':       { label: 'Im Bau',      color: 'bg-amber-100 text-amber-700' },
  'aktiv':        { label: 'Aktiv',        color: 'bg-green-100 text-green-700' },
  'abgeschlossen':{ label: 'Abgeschlossen',color: 'bg-gray-100 text-gray-600'  },
  'planung':      { label: 'In Planung',   color: 'bg-blue-100 text-blue-700'  },
};
const s = statusConfig[status];
---

{variant === 'featured' ? (
  <a href={href} class="group block card overflow-hidden">
    <div class="md:grid md:grid-cols-2">
      <div class="relative h-64 md:h-auto overflow-hidden">
        {image ? (
          <img src={image} alt={imageAlt ?? title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
        ) : (
          <div class="w-full h-full bg-gradient-cta flex items-center justify-center">
            <span class="font-serif text-white text-h1 opacity-30">{title[0]}</span>
          </div>
        )}
        <div class="absolute inset-0 bg-gradient-hero opacity-40" />
      </div>
      <div class="p-8 flex flex-col justify-center">
        <div class="flex items-center gap-3 mb-3">
          {label && <span class="text-caption text-brand-ocker/80 font-semibold uppercase tracking-wider">{label}</span>}
          <span class={`text-caption px-2.5 py-0.5 rounded-full font-semibold ${s.color}`}>{s.label}</span>
        </div>
        <h3 class="font-serif text-h3 text-brand-text mb-3 group-hover:text-brand-ocker transition-colors">{title}</h3>
        <p class="text-body text-brand-text/70 mb-5 leading-relaxed">{description}</p>
        <span class="btn-ghost self-start">Mehr erfahren →</span>
      </div>
    </div>
  </a>
) : variant === 'horizontal' ? (
  <a href={href} class="group flex gap-5 card p-5 overflow-hidden">
    <div class="relative w-32 h-24 flex-shrink-0 rounded-lg overflow-hidden">
      {image ? (
        <img src={image} alt={imageAlt ?? title} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
      ) : (
        <div class="w-full h-full bg-gradient-cta" />
      )}
    </div>
    <div class="flex-1 min-w-0">
      <span class={`text-caption px-2.5 py-0.5 rounded-full font-semibold ${s.color}`}>{s.label}</span>
      <h3 class="font-serif text-h4 text-brand-text mt-1 mb-1.5 group-hover:text-brand-ocker transition-colors truncate">{title}</h3>
      <p class="text-small text-brand-text/60 line-clamp-2">{description}</p>
    </div>
  </a>
) : (
  <a href={href} class="group flex flex-col card overflow-hidden">
    <div class="relative h-48 overflow-hidden">
      {image ? (
        <img src={image} alt={imageAlt ?? title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
      ) : (
        <div class="w-full h-full bg-gradient-cta flex items-center justify-center">
          <span class="font-serif text-white text-display opacity-20">{title[0]}</span>
        </div>
      )}
      <div class="absolute top-3 left-3">
        <span class={`text-caption px-2.5 py-1 rounded-full font-semibold backdrop-blur-sm ${s.color}`}>{s.label}</span>
      </div>
    </div>
    <div class="p-6 flex flex-col flex-1">
      {label && <p class="text-caption text-brand-ocker/80 font-semibold uppercase tracking-wider mb-2">{label}</p>}
      <h3 class="font-serif text-h3 text-brand-text mb-3 group-hover:text-brand-ocker transition-colors">{title}</h3>
      <p class="text-body text-brand-text/70 mb-5 flex-1 leading-relaxed">{description}</p>
      <span class="btn-ghost self-start">Mehr erfahren →</span>
    </div>
  </a>
)}
