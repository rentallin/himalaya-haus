---
interface Props {
  variant?: 'fullwidth' | 'sidebar' | 'minimal';
  title?: string;
  description?: string;
}

const {
  variant = 'fullwidth',
  title = 'Jetzt direkt unterstützen',
  description = 'Ihre Spende geht direkt in den Aufbau der Nalanda Schule. Sicher, einfach und steuerlich absetzbar.',
} = Astro.props;

// Stripe Payment Links — werden via .env gesetzt
const stripeLinks = {
  spende25:      import.meta.env.PUBLIC_STRIPE_LINK_SPENDE_25    || '#stripe-nicht-konfiguriert',
  spende50:      import.meta.env.PUBLIC_STRIPE_LINK_SPENDE_50    || '#stripe-nicht-konfiguriert',
  spende100:     import.meta.env.PUBLIC_STRIPE_LINK_SPENDE_100   || '#stripe-nicht-konfiguriert',
  dauerspende:   import.meta.env.PUBLIC_STRIPE_LINK_DAUERSPENDE  || '#stripe-nicht-konfiguriert',
};

const isPlaceholder = stripeLinks.spende25.includes('nicht-konfiguriert');
---

{variant === 'minimal' ? (
  <div class="p-6 rounded-card bg-gradient-cta text-white">
    <h3 class="font-serif text-h4 mb-2">{title}</h3>
    <p class="text-small text-white/80 mb-4">{description}</p>
    <a href="/unterstuetzen/spenden/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-brand-erde font-semibold text-small transition-all hover:bg-brand-creme hover:scale-105">
      Jetzt spenden →
    </a>
  </div>
) : variant === 'sidebar' ? (
  <div class="sticky top-28 p-6 rounded-card bg-white shadow-card-lg border border-brand-creme-dark">
    <h3 class="font-serif text-h4 text-brand-text mb-2">{title}</h3>
    <p class="text-small text-brand-text/70 mb-5">{description}</p>

    {isPlaceholder && (
      <div class="mb-4 p-3 rounded-lg bg-amber-50 border border-amber-200 text-caption text-amber-700">
        Stripe-Links noch nicht konfiguriert. Bitte .env befüllen.
      </div>
    )}

    <div class="space-y-2">
      <a href={stripeLinks.spende25} class="btn-secondary w-full justify-center text-center py-3">
        25 € spenden
      </a>
      <a href={stripeLinks.spende50} class="btn-primary w-full justify-center text-center py-3">
        50 € spenden
      </a>
      <a href={stripeLinks.spende100} class="w-full flex items-center justify-center gap-2 py-3 rounded-full bg-brand-rot text-white font-semibold text-body transition-all hover:scale-105 hover:shadow-lg">
        100 € spenden
      </a>
      <a href={stripeLinks.dauerspende} class="block text-center text-small text-brand-ocker hover:text-brand-erde transition-colors py-1">
        Oder monatlich spenden →
      </a>
    </div>

    <div class="mt-5 pt-5 border-t border-brand-creme-dark">
      <div class="flex items-center gap-2 text-caption text-brand-text/50">
        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Sichere Zahlung via Stripe · Karte, SEPA, PayPal, Klarna
      </div>
      <div class="flex items-center gap-2 text-caption text-brand-text/50 mt-1.5">
        <svg class="w-4 h-4 text-brand-ocker" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
        </svg>
        Steuerlich absetzbar · Quittung auf Anfrage
      </div>
    </div>
  </div>
) : (
  <!-- fullwidth variant -->
  <section class="section-padding bg-gradient-cta relative overflow-hidden">
    <!-- Decorative -->
    <div class="absolute inset-0 opacity-10">
      <svg class="absolute -top-12 -right-12 w-64 h-64" fill="white" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="80" />
      </svg>
      <svg class="absolute -bottom-8 -left-8 w-48 h-48" fill="white" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="60" />
      </svg>
    </div>

    <div class="container-content relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="font-serif text-h2 text-white mb-4">{title}</h2>
        <p class="text-white/85 text-body-lg">{description}</p>
      </div>

      {isPlaceholder && (
        <div class="max-w-lg mx-auto mb-6 p-4 rounded-card bg-white/15 backdrop-blur-sm text-small text-white/90 text-center">
          ⚙️ Stripe-Payment-Links noch nicht konfiguriert. Bitte <code class="bg-white/20 px-1 rounded">.env</code> befüllen.
        </div>
      )}

      <!-- Amount Buttons -->
      <div
        x-data="{ selected: '50', custom: '' }"
        class="max-w-lg mx-auto"
      >
        <div class="grid grid-cols-3 gap-3 mb-4">
          {[
            { amount: '25', href: stripeLinks.spende25 },
            { amount: '50', href: stripeLinks.spende50 },
            { amount: '100', href: stripeLinks.spende100 },
          ].map(({ amount, href }) => (
            <a
              href={href}
              class="group relative flex flex-col items-center justify-center py-4 rounded-card bg-white/15 backdrop-blur-sm border-2 border-white/20 text-white font-semibold transition-all duration-200 hover:bg-white hover:text-brand-erde hover:border-white hover:scale-105 hover:shadow-lg"
            >
              <span class="text-h3 font-serif">{amount} €</span>
              <span class="text-caption opacity-70 group-hover:opacity-100">einmalig</span>
            </a>
          ))}
        </div>

        <a
          href={stripeLinks.dauerspende}
          class="flex items-center justify-center gap-3 w-full py-4 rounded-card bg-white text-brand-erde font-semibold text-body-lg transition-all duration-200 hover:bg-brand-creme hover:scale-105 hover:shadow-xl"
        >
          <svg class="w-5 h-5 text-brand-ocker" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Monatlich spenden (Dauerspende)
        </a>

        <p class="text-center text-small text-white/60 mt-4">
          Karte · SEPA-Lastschrift · PayPal · Klarna · Apple/Google Pay · Steuerlich absetzbar
        </p>
      </div>

      <!-- Bank transfer fallback -->
      <div class="max-w-lg mx-auto mt-8 pt-8 border-t border-white/20 text-center">
        <p class="text-small text-white/70">
          Lieber per Überweisung?
          <a href="/unterstuetzen/spenden/#bankverbindung" class="text-white underline hover:no-underline ml-1">Bankdaten anzeigen</a>
        </p>
      </div>
    </div>
  </section>
)}
