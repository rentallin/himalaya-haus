---
import { url } from '@/utils/url';

const navItems = [
  {
    label: 'Über uns',
    href: url('/ueber-uns/'),
    children: [
      { label: 'Der Verein', href: url('/ueber-uns/') },
      { label: 'Lama Konchok Samten', href: url('/ueber-uns/lama-konchok/') },
      { label: 'Jahresberichte', href: url('/ueber-uns/vorstand/') },
    ],
  },
  {
    label: 'Projekte',
    href: url('/projekte/'),
    children: [
      { label: 'Nalanda Schule & Waisenhaus', href: url('/projekte/nalanda-schule/') },
      { label: 'Patenschaft', href: url('/projekte/patenschaft/') },
      { label: 'Medical Camp', href: url('/projekte/medical-camp/') },
    ],
  },
  { label: 'Blog', href: url('/blog/') },
  { label: 'Wirkung', href: url('/wirkung/') },
];

const currentPath = Astro.url.pathname;
const homeUrl = url('/');
const isActive = (href: string) => currentPath === href || (currentPath.startsWith(href) && href !== homeUrl);
---

<header
  x-data="{ scrolled: false, mobileOpen: false, openDropdown: null }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 80 })"
  :class="scrolled ? 'bg-brand-creme/95 backdrop-blur-sm shadow-card' : 'bg-transparent'"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-content-wide mx-auto px-4 sm:px-6 lg:px-8" aria-label="Hauptnavigation">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href={url('/')} class="flex items-center gap-3 group flex-shrink-0">
        <div class="w-10 h-10 rounded-full bg-gradient-cta flex items-center justify-center shadow-btn transition-transform duration-200 group-hover:scale-105">
          <span class="text-white font-serif font-bold text-body-lg leading-none">H</span>
        </div>
        <div :class="scrolled ? 'text-brand-text' : 'text-white'" class="transition-colors duration-300">
          <div class="font-serif font-bold text-body leading-tight">Himalaya-Haus</div>
          <div class="text-caption leading-tight opacity-80">e.V.</div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map(item => (
          <div class="relative" x-data="{ open: false }">
            {item.children ? (
              <>
                <button
                  @mouseenter="open = true"
                  @mouseleave="open = false"
                  :class="scrolled ? 'text-brand-text hover:text-brand-ocker' : 'text-white hover:text-brand-ocker-light'"
                  class={`flex items-center gap-1 px-4 py-2 rounded-lg text-body font-semibold transition-colors duration-150 ${isActive(item.href) ? 'text-brand-ocker' : ''}`}
                >
                  {item.label}
                  <svg class="w-4 h-4 transition-transform duration-150" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <!-- Dropdown -->
                <div
                  x-show="open"
                  @mouseenter="open = true"
                  @mouseleave="open = false"
                  x-transition:enter="transition ease-out duration-150"
                  x-transition:enter-start="opacity-0 translate-y-1"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  x-transition:leave="transition ease-in duration-100"
                  x-transition:leave-start="opacity-100 translate-y-0"
                  x-transition:leave-end="opacity-0 translate-y-1"
                  class="absolute top-full left-0 mt-1 w-64 bg-white rounded-card shadow-card-lg py-2 border border-brand-creme-dark"
                >
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      class={`block px-4 py-2.5 text-body text-brand-text hover:bg-brand-creme hover:text-brand-ocker transition-colors duration-100 ${isActive(child.href) ? 'text-brand-ocker border-l-2 border-brand-ocker pl-3.5' : ''}`}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <a
                href={item.href}
                :class="scrolled ? 'text-brand-text hover:text-brand-ocker' : 'text-white hover:text-brand-ocker-light'"
                class={`px-4 py-2 rounded-lg text-body font-semibold transition-colors duration-150 ${isActive(item.href) ? 'text-brand-ocker' : ''}`}
              >
                {item.label}
              </a>
            )}
          </div>
        ))}

        <a href={url('/unterstuetzen/spenden/')} class="btn-primary ml-4">
          Jetzt spenden
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        @click="mobileOpen = !mobileOpen"
        :class="scrolled ? 'text-brand-text' : 'text-white'"
        class="lg:hidden p-2 rounded-lg transition-colors duration-150 hover:bg-white/10"
        :aria-expanded="mobileOpen"
        aria-label="Menü öffnen"
      >
        <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-x-full"
    x-transition:enter-end="opacity-100 translate-x-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-x-0"
    x-transition:leave-end="opacity-0 translate-x-full"
    class="fixed inset-0 top-0 z-40 bg-brand-creme lg:hidden"
    @click.outside="mobileOpen = false"
  >
    <div class="flex flex-col h-full pt-24 px-6 pb-8 overflow-y-auto">
      <nav class="flex-1 space-y-1">
        {navItems.map(item => (
          <div x-data="{ open: false }">
            {item.children ? (
              <>
                <button
                  @click="open = !open"
                  class="w-full flex items-center justify-between px-4 py-3 rounded-lg text-body-lg font-semibold text-brand-text hover:bg-brand-creme-dark transition-colors"
                >
                  {item.label}
                  <svg class="w-5 h-5 transition-transform duration-150" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div x-show="open" class="pl-4 mt-1 space-y-1">
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      @click="mobileOpen = false"
                      class="block px-4 py-2.5 rounded-lg text-body text-brand-text/80 hover:text-brand-ocker hover:bg-brand-creme-dark transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <a
                href={item.href}
                @click="mobileOpen = false"
                class="block px-4 py-3 rounded-lg text-body-lg font-semibold text-brand-text hover:bg-brand-creme-dark hover:text-brand-ocker transition-colors"
              >
                {item.label}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- Mobile Spenden-Button (fixiert unten) -->
      <div class="pt-6 border-t border-brand-creme-dark">
        <a href={url('/unterstuetzen/spenden/')} @click="mobileOpen = false" class="btn-primary w-full justify-center text-center">
          Jetzt spenden
        </a>
        <a href={url('/unterstuetzen/patenschaft/')} @click="mobileOpen = false" class="btn-secondary w-full justify-center text-center mt-3">
          Patenschaft übernehmen
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer für nicht-Hero-Seiten -->
<div class="h-20" id="header-spacer" style="display:none;" />
<script>
  // Spacer nur anzeigen wenn kein Hero mit negativem Margin folgt
  const firstMain = document.querySelector('main > *');
  if (firstMain && !firstMain.classList.contains('hero-section')) {
    const spacer = document.getElementById('header-spacer');
    if (spacer) spacer.style.display = 'block';
  }
</script>
